{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Syntalic/OASIS/spec/endpoint-record.schema.json",
  "title": "EndpointRecord",
  "type": "object",
  "required": [
    "id",
    "origin",
    "method",
    "path",
    "summary",
    "payment",
    "search_text",
    "built_at"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "origin": { "type": "string", "format": "uri" },
    "method": {
      "type": "string",
      "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
    },
    "path": { "type": "string", "minLength": 1 },
    "operation_id": { "type": "string" },
    "summary": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "provider_fqn": { "type": "string" },
    "provider_title": { "type": "string" },
    "category": { "type": "string" },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" }
    },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "facets": { "$ref": "#/$defs/EndpointFacets" },
    "payment": { "$ref": "#/$defs/Payment" },
    "service": { "$ref": "#/$defs/ServiceInfo" },
    "responses": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "has200": { "type": "boolean" },
        "has402": { "type": "boolean" }
      }
    },
    "schema_missing": { "type": "boolean" },
    "guidance_available": { "type": "boolean" },
    "openapi_url": { "type": "string", "format": "uri" },
    "input_schema_ref": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "output_schema_ref": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "schema_source": { "type": "string", "enum": ["openapi", "bazaar"] },
    "schema_captured_at": { "type": "string", "format": "date-time" },
    "schema_truncated": { "type": "boolean" },
    "payment_verified": { "enum": ["verified", "contradicted", "unknown"] },
    "payment_verified_at": { "type": "string", "format": "date-time" },
    "search_text": { "type": "string" },
    "keyphrases": { "type": "array", "items": { "type": "string" } },
    "host_breadth": { "type": "number" },
    "field_maps": {
      "type": "array",
      "description": "Curated entity-property → request field maps (from ontology/bindings). Materialized at enrich time.",
      "items": {
        "type": "object",
        "required": ["entity", "property", "in", "path"],
        "additionalProperties": false,
        "properties": {
          "entity": { "type": "string" },
          "property": { "type": "string" },
          "in": { "enum": ["path", "query", "header", "body"] },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "usage": {
      "type": "object",
      "description": "On-chain demand snapshot (merchant payTo). Stage activity = any traffic; stage volume = full ranking metrics. Service-level de facto (shared wallet).",
      "additionalProperties": false,
      "required": ["observed_at", "source"],
      "properties": {
        "active": { "type": "boolean" },
        "stage": { "enum": ["activity", "volume"] },
        "volume_usd": { "type": "number", "minimum": 0 },
        "transactions": { "type": "integer", "minimum": 0 },
        "unique_buyers": { "type": "integer", "minimum": 0 },
        "window_days": { "type": "number" },
        "observed_at": { "type": "string", "format": "date-time" },
        "source": { "enum": ["base-blockscout", "solana-rpc", "mixed", "bazaar", "dune"] },
        "pay_tos": { "type": "array", "items": { "type": "string" } }
      }
    },
    "built_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "EndpointFacets": {
      "type": "object",
      "additionalProperties": false,
      "description": "Derived facets caching the path/summary/inputs signal. Not new information.",
      "properties": {
        "domain": {
          "enum": [
            "commerce",
            "ai",
            "data",
            "web",
            "comms",
            "finance",
            "maps",
            "travel",
            "realestate",
            "social",
            "media",
            "cloud",
            "compute",
            "devtools",
            "blockchain",
            "identity",
            "agent",
            "utility",
            "science",
            "gov"
          ]
        },
        "primary_entity": { "type": "string" },
        "output_entity": { "type": "string" },
        "modality": {
          "type": "array",
          "items": {
            "enum": [
              "text",
              "html",
              "markdown",
              "json",
              "image",
              "audio",
              "vector",
              "citations",
              "timeseries"
            ]
          }
        },
        "action": {
          "enum": [
            "search", "lookup", "compare", "extract", "generate", "transform",
            "validate", "send", "provision", "analyze", "execute", "monitor"
          ]
        },
        "authored": { "type": "boolean" }
      }
    },
    "PaymentRail": {
      "type": "object",
      "required": ["protocol"],
      "properties": {
        "protocol": { "type": "string", "enum": ["x402", "mpp"] },
        "version": { "type": "string" },
        "networks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Payment": {
      "type": "object",
      "required": ["rails"],
      "properties": {
        "price_usd": { "type": "number", "minimum": 0 },
        "paid": { "type": "boolean" },
        "currency": { "type": "string" },
        "rails": {
          "type": "array",
          "items": { "$ref": "#/$defs/PaymentRail" }
        },
        "offers": {
          "type": "array",
          "items": { "$ref": "#/$defs/PaymentOffer" }
        },
        "live_challenge": {
          "type": "array",
          "items": { "$ref": "#/$defs/LiveChallenge" }
        },
        "declared_pay_tos": {
          "type": "array",
          "items": { "$ref": "#/$defs/DeclaredPayTo" },
          "description": "Merchant wallets declared in OpenAPI (recipient/payTo/faremeter); not live-verified"
        }
      }
    },
    "DeclaredPayTo": {
      "type": "object",
      "required": ["payTo"],
      "properties": {
        "payTo": { "type": "string", "minLength": 1 },
        "network": { "type": "string" },
        "asset": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "PaymentOffer": {
      "type": "object",
      "required": ["intent", "method", "amount"],
      "properties": {
        "intent": { "type": "string", "enum": ["charge", "session"] },
        "method": { "type": "string" },
        "amount": { "type": ["string", "null"] },
        "currency": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "ServiceInfo": {
      "type": "object",
      "properties": {
        "categories": { "type": "array", "items": { "type": "string" } },
        "docs": {
          "type": "object",
          "properties": {
            "apiReference": { "type": "string" },
            "homepage": { "type": "string" },
            "llms": { "type": "string" }
          }
        }
      }
    },
    "LiveAccept": {
      "type": "object",
      "properties": {
        "scheme": { "type": "string" },
        "network": { "type": "string" },
        "asset": { "type": "string" },
        "payTo": { "type": "string" },
        "amount": { "type": "string" },
        "maxAmountRequired": { "type": "string" },
        "extra": { "type": "object" }
      }
    },
    "LiveChallenge": {
      "type": "object",
      "required": ["protocol"],
      "properties": {
        "protocol": { "type": "string", "enum": ["x402", "mpp"] },
        "accepts": {
          "type": "array",
          "items": { "$ref": "#/$defs/LiveAccept" }
        },
        "www_authenticate": { "type": "string" },
        "method": { "type": "string" },
        "intent": { "type": "string" },
        "realm": { "type": "string" }
      }
    }
  }
}